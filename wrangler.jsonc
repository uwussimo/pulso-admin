{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "pulso-admin",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes resolve to the SPA shell.
    "not_found_handling": "single-page-application",
    // Only API calls go through the Worker; everything else is served straight from assets.
    "run_worker_first": ["/internal/*", "/v1/*", "/metrics/*"],
  },
  "vars": {
    "API_ORIGIN": "https://api.pulso.dorim.com",
    // Mobile app analytics (read-only, Обзор → «Приложение»). The personal API
    // key is a secret: `npx wrangler secret put POSTHOG_API_KEY`.
    "POSTHOG_HOST": "https://us.posthog.com",
    "POSTHOG_PROJECT_ID": "675346",
  },
}
