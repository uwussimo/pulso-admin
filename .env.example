# Base URL of the API. Leave empty in development: Vite proxies /internal/* and /v1/* to VITE_API_PROXY_TARGET.
VITE_API_BASE=
# Where the dev proxy forwards /internal/* and /v1/* requests.
VITE_API_PROXY_TARGET=https://api.pulso.dorim.com
# Deep link the public survey page (/s/:id) falls back to when opened outside the app's WebView.
VITE_PULSO_DEEP_LINK=pulso://polls
